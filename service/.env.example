NODE_ENV=development
PORT=4000

DATABASE_URL="mysql://root:password@localhost:3306/bloomo"

JWT_ACCESS_SECRET="change-me-in-prod-access"
JWT_REFRESH_SECRET="change-me-in-prod-refresh"
JWT_ACCESS_TTL="24h"
JWT_REFRESH_TTL="30d"

FRONTEND_ORIGIN="http://localhost:3000"
COOKIE_DOMAIN="localhost"

SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Bloomo <no-reply@bloomo.local>"

# --- WhatsApp ---
# "web"   = per-company QR pairing via Baileys (multi-tenant, free, each admin uses their own number)
# "cloud" = Meta Business Cloud API (official, one business number)
# "stub"  = logs only, no real send (dev)
WHATSAPP_PROVIDER=web

# Meta WhatsApp Business Cloud API credentials
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Random secret you choose (also enter same value in Meta dashboard webhook config)
WHATSAPP_VERIFY_TOKEN=change-me-bloomo-webhook-verify

WHATSAPP_SESSION_DIR="./.wa-sessions"
WHATSAPP_DAILY_CAP_DEFAULT=300
WHATSAPP_MIN_DELAY_MS=1000
WHATSAPP_MAX_DELAY_MS=3000

LOCATION_FRESHNESS_MIN=5
START_TASK_RADIUS_M=200
