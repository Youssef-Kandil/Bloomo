// Bloomo — Field Service Management
// Prisma schema (MySQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE
  CLIENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  PENDING_APPROVAL
  COMPLETED
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskType {
  COLLECTION
  SUPPLY
  INSTALL
  SUPPLY_INSTALL
  INSPECTION
  MAINTENANCE
  REPAIR
  OTHER
}

enum RequestType {
  MAINTENANCE
  INSPECTION
  REPAIR
  SUPPLY
  INSTALL
  SUPPLY_INSTALL
}

enum RequestStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
}

enum AttendanceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TreasuryKind {
  INCOME
  EXPENSE
}

enum AppTreasuryKind {
  INCOME
  EXPENSE
}

/// Categories for OWNER-tracked app-level expenses.
/// SUBSCRIPTION is used as the auto-tag for income from sub activations/extensions.
enum AppExpenseCategory {
  INFRASTRUCTURE
  SALARIES
  MARKETING
  TOOLS
  TAXES
  REFUND
  OTHER
}

enum WaSessionStatus {
  DISCONNECTED
  PAIRING
  CONNECTED
}

enum WaHealthState {
  HEALTHY
  THROTTLED
  BANNED_SUSPECTED
}

enum WaTemplate {
  OTP_VERIFY
  ORDER_RECEIVED
  TECH_ASSIGNED
  ETA
  COMPLETED
  GREETING
  BROADCAST
  CUSTOM
  EMP_OTP_VERIFY
  EMP_TASK_ASSIGNED
  EMP_TOOL_CUSTODY
  EMP_INVENTORY_CUSTODY
}

enum WaMessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum OtpPurpose {
  CLIENT_PHONE_VERIFY
  EMPLOYEE_PHONE_VERIFY
  LOGIN_2FA
}

// ---------- Core ----------

model Company {
  id           String   @id @default(cuid())
  name         String
  ownerAdminId String   @unique
  owner        User     @relation("CompanyOwner", fields: [ownerAdminId], references: [id])
  createdAt    DateTime @default(now())

  // Payroll defaults
  standardWorkingDaysPerMonth Int   @default(26)
  overtimeMultiplier          Float @default(1.5)

  users            User[]            @relation("CompanyUsers")
  branches         Branch[]
  clients          Client[]
  tools            Tool[]
  inventoryItems   InventoryItem[]
  tasks            Task[]
  requests         Request[]
  treasuryEntries  TreasuryEntry[]
  whatsappSession  WhatsappSession?
  whatsappMessages WhatsappMessage[]
  supplyOps        SupplyOperation[]
  offDayRequests   OffDayAttendanceRequest[]
  overtimeRequests OvertimeRequest[]
  leaveRequests    LeaveRequest[]
  salaryAdvances   SalaryAdvance[]
  subscription     Subscription?
  subscriptionRequests SubscriptionRequest[]
}

enum SubscriptionPlan {
  TRIAL
  BASIC
  PRO
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  EXPIRED
  PENDING_ACTIVATION
}

model Subscription {
  id                String              @id @default(cuid())
  companyId         String              @unique
  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan              SubscriptionPlan    @default(TRIAL)
  billingCycle      BillingCycle?
  status            SubscriptionStatus  @default(TRIALING)
  trialEndsAt       DateTime?
  currentPeriodEnd  DateTime?
  customClientsLimit   Int?
  customEmployeesLimit Int?
  customBranchesLimit  Int?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model Plan {
  id              String           @id @default(cuid())
  key             SubscriptionPlan @unique
  name            String
  tagline         String?
  monthlyPrice    Float
  yearlyPrice     Float
  currency        String           @default("EGP")
  clientsLimit    Int
  employeesLimit  Int
  branchesLimit   Int              @default(1)
  active          Boolean          @default(true)
  highlight       Boolean          @default(false)
  sortOrder       Int              @default(0)
  updatedAt       DateTime         @updatedAt
}

model Offer {
  id              String   @id @default(cuid())
  code            String   @unique
  title           String
  description     String?  @db.Text
  discountPercent Int
  validFrom       DateTime
  validUntil      DateTime
  active          Boolean  @default(true)
  appliesTo       Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active, validUntil])
}

model SubscriptionRequest {
  id           String           @id @default(cuid())
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan
  billingCycle BillingCycle
  contactName  String
  contactEmail String
  contactPhone String?
  note         String?          @db.Text

  // Optional custom-limit ask. When the OWNER approves, these (if present)
  // override the Plan's defaults on the Subscription.
  customClientsLimit   Int?
  customEmployeesLimit Int?
  customBranchesLimit  Int?

  // PENDING | APPROVED | REJECTED | QUOTED
  // QUOTED = OWNER has sent a price quote / payment instructions; admin still
  // needs to act (out of band) before the OWNER moves to APPROVED.
  status       String           @default("PENDING")
  rejectReason String?          @db.Text
  ownerMessage String?          @db.Text   // shown in the admin's plan banner (e.g. quote details)
  decidedAt    DateTime?
  decidedByUserId String?

  createdAt    DateTime         @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, status])
}

model Branch {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  lat       Float?
  lng       Float?
  phones    Json    @default("[]")

  employees Employee[]
  managers  User[]    @relation("ManagerBranch")

  @@index([companyId])
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  role               Role
  companyId          String?
  company            Company?  @relation("CompanyUsers", fields: [companyId], references: [id])
  branchId           String?
  branch             Branch?   @relation("ManagerBranch", fields: [branchId], references: [id])
  name               String
  avatar             String?
  active             Boolean   @default(true)
  bannedAt           DateTime?
  bannedReason       String?   @db.Text
  whatsappPhone      String?
  whatsappVerifiedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  ownedCompany        Company?          @relation("CompanyOwner")
  employee            Employee?
  clientProfile       Client?           @relation("ClientAccount")
  permissions         Permission[]      @relation("ManagerPermissions")
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]
  assignmentsMade     Assignment[]      @relation("AssignedBy")
  tasksAssigned       Task[]            @relation("TaskAssignee")
  tasksCreated        Task[]            @relation("TaskCreatedBy")
  attendanceDecisions Attendance[]      @relation("AttendanceDecider")
  ratingsRecorded     Rating[]          @relation("RatingRecorder")
  treasuryCreated     TreasuryEntry[]   @relation("TreasuryCreator")
  whatsappSent        WhatsappMessage[] @relation("WhatsappSender")
  supplyOpsAsEmployee SupplyOperation[] @relation("SupplyOpEmployee")
  supplyOpsCreated    SupplyOperation[] @relation("SupplyOpCreator")
  tasksApproved       Task[]            @relation("TaskApprover")
  offDayDecisions     OffDayAttendanceRequest[] @relation("OffDayDecider")
  overtimeDecisions   OvertimeRequest[]         @relation("OvertimeDecider")
  leaveDecisions      LeaveRequest[]            @relation("LeaveDecider")
  advanceDecisions    SalaryAdvance[]           @relation("AdvanceDecider")
  appTreasuryCreated  AppTreasuryEntry[]        @relation("AppTreasuryCreator")

  @@index([companyId, role])
}

model Permission {
  id        String  @id @default(cuid())
  managerId String
  manager   User    @relation("ManagerPermissions", fields: [managerId], references: [id], onDelete: Cascade)
  screenKey String
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)
  canAssign Boolean @default(false)

  @@unique([managerId, screenKey])
}

model Employee {
  id           String    @id
  user         User      @relation(fields: [id], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?   @relation(fields: [branchId], references: [id])
  currentLat   Float?
  currentLng   Float?
  lastPingAt   DateTime?

  // Schedule — "HH:mm" 24-hour format; offDays is a JSON array of weekday numbers (0=Sunday … 6=Saturday)
  checkInTime            String?
  checkOutTime           String?
  offDays                Json    @default("[5,6]")

  // Payroll
  monthlySalary          Float   @default(0)
  overtimeRateOverride   Float?
  offDayHourRateOverride Float?

  offDayRequests         OffDayAttendanceRequest[]
  overtimeRequests       OvertimeRequest[]
  leaveRequests          LeaveRequest[]
  salaryAdvances         SalaryAdvance[]

  toolCustody    ToolAssignment[]
  assignments    Assignment[]
  attendance     Attendance[]
  locationPings  LocationPing[]

  @@index([branchId])
}

// ---------- Clients ----------

model Client {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountUserId   String?  @unique
  accountUser     User?    @relation("ClientAccount", fields: [accountUserId], references: [id])
  name            String
  note            String?  @db.Text
  address         String
  lat             Float
  lng             Float
  marketingOptIn  Boolean  @default(false)
  createdAt       DateTime @default(now())

  phones   ClientPhone[]
  requests Request[]
  ratings  Rating[]
  tasks    Task[]
  supplyOps SupplyOperation[]

  @@index([companyId])
}

model ClientPhone {
  id                 String    @id @default(cuid())
  clientId           String
  client             Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label              String
  phone              String
  isWhatsapp         Boolean   @default(false)
  whatsappVerifiedAt DateTime?

  @@index([clientId])
  @@index([phone])
}

// ---------- Tools & Inventory ----------

model Tool {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  code      String
  qty       Int     @default(0)

  assignments ToolAssignment[]

  @@unique([companyId, code])
}

model ToolAssignment {
  id         String    @id @default(cuid())
  toolId     String
  tool       Tool      @relation(fields: [toolId], references: [id])
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  qty        Int
  note       String?
  assignedAt DateTime  @default(now())
  returnedAt DateTime?

  @@index([employeeId])
  @@index([toolId])
}

model InventoryItem {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  sku       String
  type      String?
  icon      String?
  qty       Int     @default(0)
  unitPrice Float   @default(0)

  requestCustody  RequestCustody[]
  supplyOpItems   SupplyOperationItem[]

  @@unique([companyId, sku])
}

// ---------- Requests ----------

model Request {
  id        String        @id @default(cuid())
  companyId String
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id])
  type      RequestType
  note      String?       @db.Text
  /// Relative URL (e.g. "/uploads/voice-notes/abc.webm") for an optional
  /// recorded voice note attached at request creation. The file itself
  /// lives on disk under UPLOAD_DIR — stored as URL only to keep rows
  /// small and let the file be served with caching headers.
  voiceNoteUrl     String?  @db.VarChar(255)
  voiceDurationMs  Int?
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  assignments Assignment[]
  custody     RequestCustody[]
  ratings     Rating[]
  history     RequestHistory[]

  @@index([companyId, status])
  @@index([clientId])
  @@index([createdAt])
}

model Assignment {
  id              String    @id @default(cuid())
  requestId       String
  request         Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id])
  plannedStart    DateTime
  plannedEnd      DateTime
  actualStart     DateTime?
  actualEnd       DateTime?
  finishNote      String?   @db.Text
  assignedByUserId String
  assignedBy      User      @relation("AssignedBy", fields: [assignedByUserId], references: [id])
  createdAt       DateTime  @default(now())

  @@index([requestId])
  @@index([employeeId, actualStart])
}

model Task {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  type        TaskType
  clientId    String?
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  plannedStart DateTime?
  plannedEnd   DateTime?
  actualStart  DateTime?
  actualEnd    DateTime?
  assigneeId  String
  assignee    User         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById String
  createdBy   User         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  operationId String?
  operation   SupplyOperation? @relation(fields: [operationId], references: [id], onDelete: SetNull)
  collectionAmount Float?
  approvedAt       DateTime?
  approvedById     String?
  approvedBy       User?        @relation("TaskApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([companyId, status])
  @@index([assigneeId, status])
  @@index([clientId])
  @@index([operationId])
}

model SupplyOperation {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      User      @relation("SupplyOpEmployee", fields: [employeeId], references: [id])
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id])
  needsInstall  Boolean   @default(false)
  invoiceAmount Float?
  isDeferred    Boolean   @default(false)
  paidAt        DateTime?
  note          String?   @db.Text
  createdById   String
  createdBy     User      @relation("SupplyOpCreator", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())

  items SupplyOperationItem[]
  tasks Task[]

  @@index([companyId, createdAt])
  @@index([employeeId])
  @@index([clientId])
}

model SupplyOperationItem {
  id              String          @id @default(cuid())
  operationId     String
  operation       SupplyOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem   @relation(fields: [inventoryItemId], references: [id])
  qty             Int
  unitPrice       Float

  @@index([operationId])
  @@index([inventoryItemId])
}

model RequestCustody {
  id              String        @id @default(cuid())
  requestId       String
  request         Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  qty             Int
  unitPrice       Float
  total           Float

  @@index([requestId])
}

model Rating {
  id              String   @id @default(cuid())
  requestId       String
  request         Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id])
  stars           Int
  note            String?  @db.Text
  recordedByUserId String?
  recordedBy      User?    @relation("RatingRecorder", fields: [recordedByUserId], references: [id])
  createdAt       DateTime @default(now())

  @@index([clientId])
  @@index([requestId])
}

model RequestHistory {
  id        String   @id @default(cuid())
  requestId String
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  event     String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
}

// ---------- Attendance ----------

model Attendance {
  id              String           @id @default(cuid())
  employeeId      String
  employee        Employee         @relation(fields: [employeeId], references: [id])
  type            AttendanceType
  requestedAt     DateTime
  status          AttendanceStatus @default(PENDING)
  decidedByUserId String?
  decidedBy       User?            @relation("AttendanceDecider", fields: [decidedByUserId], references: [id])
  decidedAt       DateTime?
  rejectReason    String?          @db.Text
  createdAt       DateTime         @default(now())

  @@index([employeeId, requestedAt])
  @@index([status])
}

model OffDayAttendanceRequest {
  id              String           @id @default(cuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date            DateTime
  reason          String?          @db.Text
  status          AttendanceStatus @default(PENDING)
  decidedByUserId String?
  decidedBy       User?            @relation("OffDayDecider", fields: [decidedByUserId], references: [id])
  decidedAt       DateTime?
  createdAt       DateTime         @default(now())

  @@unique([employeeId, date])
  @@index([companyId, status])
}

/// Employee requests to work overtime (after auto check-out) on a given day.
/// Approved overtime adds hours that payroll picks up at the overtime rate.
model OvertimeRequest {
  id              String           @id @default(cuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date            DateTime         // day of overtime
  startAt         DateTime         // requested start
  endAt           DateTime         // requested end
  reason          String?          @db.Text
  status          AttendanceStatus @default(PENDING)
  decidedByUserId String?
  decidedBy       User?            @relation("OvertimeDecider", fields: [decidedByUserId], references: [id])
  decidedAt       DateTime?
  rejectReason    String?          @db.Text
  createdAt       DateTime         @default(now())

  @@index([companyId, status])
  @@index([employeeId, date])
}

/// Employee requests a leave (one or more days). Approved leaves do not
/// produce attendance deductions for the covered days.
model LeaveRequest {
  id              String           @id @default(cuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fromDate        DateTime
  toDate          DateTime
  reason          String?          @db.Text
  status          AttendanceStatus @default(PENDING)
  decidedByUserId String?
  decidedBy       User?            @relation("LeaveDecider", fields: [decidedByUserId], references: [id])
  decidedAt       DateTime?
  rejectReason    String?          @db.Text
  createdAt       DateTime         @default(now())

  @@index([companyId, status])
  @@index([employeeId, fromDate])
}

/// Employee requests a cash advance on salary. On approval, a treasury
/// EXPENSE entry is created and payroll deducts the advance from net pay
/// for that month.
model SalaryAdvance {
  id              String           @id @default(cuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount          Float
  reason          String?          @db.Text
  appliedYear     Int              // which month the advance applies to
  appliedMonth    Int              // 1..12
  status          AttendanceStatus @default(PENDING)
  decidedByUserId String?
  decidedBy       User?            @relation("AdvanceDecider", fields: [decidedByUserId], references: [id])
  decidedAt       DateTime?
  rejectReason    String?          @db.Text
  treasuryEntryId String?          @unique
  createdAt       DateTime         @default(now())

  @@index([companyId, status])
  @@index([employeeId, appliedYear, appliedMonth])
}

// ---------- Tracking ----------

model LocationPing {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  createdAt  DateTime @default(now())

  @@index([employeeId, createdAt])
}

// ---------- Treasury & Audit ----------

model TreasuryEntry {
  id              String       @id @default(cuid())
  companyId       String
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind            TreasuryKind
  amount          Float
  reason          String
  requestId       String?
  createdByUserId String
  createdBy       User         @relation("TreasuryCreator", fields: [createdByUserId], references: [id])
  createdAt       DateTime     @default(now())

  @@index([companyId, createdAt])
}

/// App-level treasury (OWNER scope, not company scope).
/// Income rows are typically auto-created when OWNER activates/extends a
/// company subscription. Expense rows are entered manually by OWNER.
model AppTreasuryEntry {
  id              String              @id @default(cuid())
  kind            AppTreasuryKind
  amount          Float
  reason          String              @db.Text
  category        AppExpenseCategory?
  plan            SubscriptionPlan?
  billingCycle    BillingCycle?
  companyId       String?
  createdByUserId String?
  createdBy       User?               @relation("AppTreasuryCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())

  @@index([createdAt])
  @@index([kind, createdAt])
  @@index([plan, createdAt])
  @@index([category])
  @@index([companyId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  meta      Json?
  ip        String?
  ua        String?  @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
}

// ---------- Auth tokens ----------

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------- WhatsApp ----------

model WhatsappSession {
  id                String          @id @default(cuid())
  companyId         String          @unique
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status            WaSessionStatus @default(DISCONNECTED)
  healthState       WaHealthState   @default(HEALTHY)
  phoneNumber       String?
  lastQrAt          DateTime?
  lastQrCode        String?         @db.Text
  connectedAt       DateTime?
  lastSeenAt        DateTime?
  dailySentCount    Int             @default(0)
  dailyWindowStart  DateTime?
  throttledUntil    DateTime?
  updatedAt         DateTime        @updatedAt
}

model WhatsappMessage {
  id            String          @id @default(cuid())
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId      String?
  requestId     String?
  toPhone       String
  body          String          @db.Text
  template      WaTemplate
  status        WaMessageStatus @default(QUEUED)
  externalId    String?         @unique
  error         String?         @db.Text
  sentByUserId  String?
  sentBy        User?           @relation("WhatsappSender", fields: [sentByUserId], references: [id])
  createdAt     DateTime        @default(now())
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?

  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([clientId])
}

model OtpCode {
  id          String     @id @default(cuid())
  channel     String     @default("WHATSAPP")
  purpose     OtpPurpose
  targetPhone String
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int        @default(0)
  relatedId   String?
  createdAt   DateTime   @default(now())

  @@index([targetPhone, purpose])
  @@index([expiresAt])
}
